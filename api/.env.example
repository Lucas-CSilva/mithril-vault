# Mithril Vault API - Backend Environment Variables
# Copy this file to .env and update with your actual values

# ============================================================================
# MongoDB Connection
# ============================================================================

# MongoDB connection URI with authentication
# Format: mongodb://username:password@host:port/database?authSource=admin
# For docker-compose: Use 'localhost' as host (MongoDB exposed on host network)
# For production: Use actual MongoDB cluster connection string
MONGODB_URI=mongodb://root:root@localhost:27017/mithril_vault?authSource=admin

# ============================================================================
# CORS Configuration
# ============================================================================

# Comma-separated list of allowed origins for CORS
# Development: Include both localhost and 127.0.0.1 for frontend dev server
# Production: Replace with actual frontend domain (e.g., https://app.mithrilvault.com)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================================
# Spring Boot Configuration
# ============================================================================

# Active Spring profile (dev, test, prod)
# Development: Use 'dev' for verbose logging and relaxed security
# Testing: Use 'test' for test database and fixtures
# Production: Use 'prod' for optimized settings
SPRING_PROFILES_ACTIVE=dev

# Server port for API (default: 8080)
SERVER_PORT=8080

# Logging level (TRACE, DEBUG, INFO, WARN, ERROR)
# Development: INFO or DEBUG
# Production: WARN or ERROR
LOG_LEVEL=INFO

# ============================================================================
# Notes
# ============================================================================
# - MongoDB must be running before starting the API (docker-compose up -d)
# - CORS origins must match frontend URL exactly (including protocol and port)
# - Never commit actual .env files with real credentials to version control
# - For production, use strong passwords generated with: openssl rand -base64 32
