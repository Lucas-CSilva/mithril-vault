# Normalize line endings: store LF in the repo, let Git handle checkout.
* text=auto eol=lf

# Scripts must stay LF even on Windows checkouts.
*.sh text eol=lf
gradlew text eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew.bat text eol=crlf

# Binary assets — never normalize or diff as text.
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
